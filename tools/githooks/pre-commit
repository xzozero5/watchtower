#!/usr/bin/env bash
# Watchtower pre-commit guard — เปิดใช้: git config core.hooksPath tools/githooks
set -euo pipefail
fail=0
files=$(git diff --cached --name-only --diff-filter=ACM || true)
for f in $files; do
  case "$f" in
    .env|.env.*|*/.env|*/.env.*) [ "$f" != ".env.example" ] && [ "${f##*/}" != ".env.example" ] && { echo "BLOCKED: $f (.env files are never committed)"; fail=1; } ;;
  esac
  if [ -f "$f" ] && [ $(wc -c <"$f") -gt 10485760 ]; then echo "BLOCKED: $f > 10 MB"; fail=1; fi
done
# secret patterns (เพิ่มได้) — ตรวจเฉพาะ diff ที่เพิ่มเข้ามา
# Match against a captured string, not a pipe: with pipefail an early `grep -q` exit can SIGPIPE the writer and hide a hit.
# Exit codes: 0 = hit, 1 = clean, anything else = the check itself failed, which also blocks (fail closed).
added=$(git diff --cached -U0 | grep -E '^\+' || true)
rc=0
LC_ALL=C grep -E -q 'sk-ant-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{30,}|-----BEGIN (RSA |EC )?PRIVATE KEY-----|"private_key_id"[[:space:]]*:|LINE_CHANNEL_SECRET=[A-Za-z0-9]{10,}|DISCORD_BOT_TOKEN=[A-Za-z0-9._-]{20,}' <<<"$added" || rc=$?
if [ "$rc" -ne 1 ]; then
  echo "BLOCKED: secret-looking string in staged diff (grep exit $rc)"; fail=1
fi
# org-neutral repo: optional local-only term list (one regex per line), kept outside the repo in .git/info/forbidden-terms
terms="$(git rev-parse --git-common-dir)/info/forbidden-terms"
if [ -s "$terms" ]; then
  # lowercase both sides because `grep -i` aborts on some Git for Windows builds
  lower() { LC_ALL=C tr '[:upper:]' '[:lower:]'; }
  rc=0
  LC_ALL=C grep -E -q -f <(lower <"$terms") <<<"$(lower <<<"$added")" || rc=$?
  if [ "$rc" -ne 1 ]; then
    echo "BLOCKED: forbidden term in staged diff (list: $terms, grep exit $rc)"; fail=1
  fi
fi
exit $fail
