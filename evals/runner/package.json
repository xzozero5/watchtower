{
  "name": "@watchtower/eval-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsc -p tsconfig.build.json && node dist/cli.js run",
    "redaction": "tsc -p tsconfig.build.json && node dist/cli.js redaction",
    "kb-similarity": "tsc -p tsconfig.build.json && node dist/cli.js kb-similarity",
    "replay": "tsc -p tsconfig.build.json && node dist/cli.js replay",
    "record": "tsc -p tsconfig.build.json && node dist/cli.js record",
    "simulate": "tsc -p tsconfig.build.json && node dist/cli.js simulate"
  },
  "dependencies": {
    "@watchtower/ai": "workspace:*",
    "@watchtower/db": "workspace:*",
    "@watchtower/domain": "workspace:*",
    "@watchtower/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
