{
  "cases": [
    {
      "id": "gold-kb-author-no-customer-detail",
      "agent": "kb_author",
      "description": "The article keeps the steps and none of the customer's own details.",
      "intent": "reset_password",
      "mockAnswer": {
        "title": "Password reset email does not arrive",
        "bodyMd": "## Symptoms\n\nThe reset email does not arrive.\n\n## Resolution\n\n1. Check the spam folder.\n2. Ask the user to request the email again.\n\n## When to escalate\n\nIf it still does not arrive, ask an engineer to check the mail logs.",
        "intentTags": [
          "reset_password"
        ],
        "kind": "article"
      },
      "input": {
        "subject": "Reset email does not arrive",
        "turns": [
          {
            "from": "customer",
            "text": "I asked for a reset email twice and nothing came."
          },
          {
            "from": "staff",
            "text": "Please check the spam folder, then request the email again from the sign in page."
          }
        ],
        "intentKey": "reset_password",
        "knownIntents": [
          "reset_password",
          "billing_question"
        ]
      },
      "expect": {
        "drafted": true,
        "tagsInclude": [
          "reset_password"
        ],
        "bodyMustNotContain": [
          "twice"
        ]
      }
    },
    {
