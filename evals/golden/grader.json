    {
      "id": "gold-grader-contained",
      "agent": "grader",
      "description": "Staff answered, the customer never came back, no survey: contained, not verified.",
      "intent": "reset_password",
      "mockAnswer": {
        "resolutionClass": "contained",
        "draftVerdict": "no_draft",
        "reasons": [
          {
            "text": "Staff gave the reset steps and the customer did not reply.",
            "factIds": [
              "f2"
            ]
          }
        ],
        "kbGap": true
      },
      "input": {
        "turns": [
          {
            "from": "customer",
            "text": "I cannot sign in, I forgot my password."
          },
          {
            "from": "staff",
            "text": "Use Forgot password on the sign in page and follow the emailed link."
          }
        ]
      },
      "expect": {
        "resolutionClass": "contained",
        "kbGap": true,
        "maxViolations": 0
      }
    },
