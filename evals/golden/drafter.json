      "intent": "reset_password",
      "mockAnswer": {
        "language": "th",
        "sentences": [
          {
            "text": "คุณสามารถรีเซ็ตรหัสผ่านได้จากหน้าเข้าสู่ระบบ โดยกด “ลืมรหัสผ่าน”",
            "kind": "instruction",
            "evidenceIds": [
              "ev-1"
            ],
            "newParagraph": false
          },
          {
            "text": "หากยังไม่ได้รับอีเมล ตอบกลับข้อความนี้ได้เลยครับ",
            "kind": "courtesy",
            "evidenceIds": [],
            "newParagraph": true
          }
        ]
      },
      "input": {
        "subject": "ล็อกอินไม่ได้",
        "turns": [
          {
            "from": "customer",
            "text": "ล็อกอินไม่ได้ครับ ลืมรหัสผ่าน"
          }
        ],
        "intentKey": "reset_password",
        "customerLanguage": "th",
        "disclosure": "restricted",
        "evidence": [
          {
            "id": "ev-1",
            "kind": "kb",
            "title": "รีเซ็ตรหัสผ่าน",
            "snippet": "กดลืมรหัสผ่านที่หน้าเข้าสู่ระบบ แล้วทำตามลิงก์ในอีเมล",
            "customerSafe": true,
            "tool": "kb_search"
          }
        ]
      },
      "expect": {
        "language": "th",
        "mustContain": [
          "รหัสผ่าน"
        ],
        "maxUncitedClaims": 0
      }
    },
