# Local reverse proxy (docker compose). TLS and the public hostname are the load balancer's job on
# GCP, so this serves plain http on the loopback-published port 8080.
#
#   /api/*            -> api (prefix stripped: /api/tickets reaches the api as /tickets)
#   /docs*            -> api (OpenAPI UI and /docs-json)
#   /ws, /ws/*        -> api (WebSocket gateway, T-005) [ASSUMED path]
#   everything else   -> web
#
# The client address: reverse_proxy puts the address it saw in X-Forwarded-For (it replaces a
# value sent by the client, because no trusted_proxies are configured) [VERIFY]. The api only
# believes that header when TRUST_PROXY_HOPS is 1, and then only if nothing but this proxy can
# reach it: use docker-compose.proxy.yml, which sets the variable and does not publish :4000.
#
# /metrics is never exposed here: Prometheus scrapes the api directly on 127.0.0.1:4000.
# /health through this proxy reaches web; probe api and worker on their own ports.

{
	auto_https off
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@internal path /metrics /metrics/* /api/metrics /api/metrics/*
	handle @internal {
		respond 404
	}

	# Request bodies are capped before they reach the api, which buffers a portal upload in memory
	# (T-140, ADR-007): 26 MB on the two portal routes that take files (the api allows 25 MB of
	# files plus form fields), 1 MB everywhere else. A larger body is cut off with 413.
	handle_path /api/* {
		@portalUpload {
			method POST
			path_regexp ^/v1/portal/tickets(/[^/]+/replies)?$
		}
		handle @portalUpload {
			request_body {
				max_size 26MB
			}
			reverse_proxy api:4000
		}
		handle {
			request_body {
				max_size 1MB
			}
			reverse_proxy api:4000
		}
	}

	@api path /docs /docs/* /docs-json /docs-yaml /ws /ws/*
	handle @api {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}
