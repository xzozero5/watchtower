{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["NEXT_TELEMETRY_DISABLED"],
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.mjs",
    "tools/eslint/boundaries.mjs",
    ".prettierrc.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build", "build"],
      "cache": false
    },
    "test:e2e:fullstack": {
      "dependsOn": ["^build", "build", "@watchtower/api#build", "@watchtower/worker#build"],
      "cache": false
    },
    "db:migrate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "eval": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "//#test:boundaries": {
      "cache": false
    },
    "//#lint:root": {
      "cache": false
    }
  }
}
