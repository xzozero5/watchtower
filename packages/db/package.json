{
  "name": "@watchtower/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm run build && node --env-file-if-exists=../../.env dist/cli.js up",
    "db:rollback": "pnpm run build && node --env-file-if-exists=../../.env dist/cli.js down",
    "db:status": "pnpm run build && node --env-file-if-exists=../../.env dist/cli.js status",
    "db:seed": "pnpm run build && node --env-file-if-exists=../../.env dist/seed-cli.js",
    "db:seed:year": "pnpm run build && node --env-file-if-exists=../../.env dist/seed-cli.js --scenario year",
    "db:mark-seed": "pnpm run build && node --env-file-if-exists=../../.env dist/mark-seed-cli.js",
    "db:grant-owner-approval": "pnpm run build && node --env-file-if-exists=../../.env dist/owner-approval-cli.js",
    "kb:sync": "pnpm run build && node --env-file-if-exists=../../.env dist/kb-sync-cli.js",
    "kb:reembed": "pnpm run build && node --env-file-if-exists=../../.env dist/kb-reembed-cli.js"
  },
  "dependencies": {
    "@watchtower/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
