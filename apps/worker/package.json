{
  "name": "@watchtower/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@watchtower/channels": "workspace:*",
    "@watchtower/db": "workspace:*",
    "@watchtower/domain": "workspace:*",
    "@watchtower/shared": "workspace:*",
    "bullmq": "^6.5.3",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "eslint": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
