{
  "name": "watchtower",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --env-mode=loose",
    "build": "turbo run build",
    "test": "turbo run test test:boundaries",
    "test:integration": "turbo run test:integration --env-mode=loose",
    "test:e2e": "turbo run test:e2e --env-mode=loose",
    "test:e2e:fullstack": "turbo run test:e2e:fullstack --env-mode=loose",
    "test:boundaries": "vitest run --dir tools --testTimeout=90000",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint eslint.config.mjs tools && prettier --check .",
    "typecheck": "turbo run typecheck",
    "db:migrate": "turbo run db:migrate --env-mode=loose",
    "db:seed": "turbo run db:seed --env-mode=loose",
    "db:seed:year": "turbo run db:seed:year --env-mode=loose",
    "db:mark-seed": "pnpm --filter @watchtower/db run db:mark-seed --",
    "db:grant-owner-approval": "pnpm --filter @watchtower/db run db:grant-owner-approval --",
    "eval": "turbo run eval --env-mode=loose",
    "kb:sync": "pnpm --filter @watchtower/db run kb:sync --",
    "push:vapid": "pnpm --filter @watchtower/api run push:vapid --",
    "claude-bridge": "node --env-file-if-exists=.env tools/claude-cli-bridge/server.mjs",
    "format": "prettier --write .",
    "push-filter": "node tools/push-only-filter/server.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "^16.4.3",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
