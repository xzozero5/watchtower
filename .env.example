# Watchtower — copy to .env (never commit .env). ค่าใน repo นี้เป็นตัวอย่างเท่านั้น
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=postgres://watchtower:watchtower@postgres:5432/watchtower
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_BUCKET=watchtower
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
JWT_SECRET=change-me
APP_ENCRYPTION_KEY=change-me-32-bytes-base64   # envelope encryption สำหรับ integration secrets ใน DB
# --- integrations: ว่าง = mock mode ---
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=
GMAIL_SERVICE_ACCOUNT_JSON_PATH=
GMAIL_IMPERSONATE_USER=
PUBSUB_EMULATOR_HOST=pubsub:8085
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_ALERT_CHANNEL_ID=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# --- AI (เลือกได้จาก admin UI; env เป็นค่าเริ่มต้น) ---
AI_PROVIDER=mock            # mock | anthropic | vertex
ANTHROPIC_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=asia-southeast1
SMTP_HOST=mailpit
SMTP_PORT=1025
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
