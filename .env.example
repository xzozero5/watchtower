# Watchtower environment. Copy to .env (never commit .env).
# Every value here is a local example, not a secret. The "change-me" secrets are accepted only on
# a laptop: the api and worker refuse to boot with a placeholder or short JWT_SECRET /
# APP_ENCRYPTION_KEY when NODE_ENV=production, or whenever APP_URL is not localhost / 127.0.0.1 /
# [::1] (a LAN address or a real host name counts as "not local"). Replace them before you expose
# the stack to anyone else.
#
# Hosts below are localhost, for `pnpm dev` and the integration tests on your machine against
# `docker compose up -d postgres redis minio mailpit`. Inside compose the containers use the
# service names (postgres, redis, minio, mailpit) automatically; docker-compose.yml builds those
# URLs itself, so DATABASE_URL, REDIS_URL, S3_ENDPOINT and SMTP_HOST here do not affect containers.

NODE_ENV=development
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- ports published on 127.0.0.1 by docker-compose.yml ---
WEB_PORT=3000
API_PORT=4000
# The worker serves its health check here.
WORKER_PORT=4100
CADDY_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025

# --- postgres (the compose database is created from these) ---
POSTGRES_USER=watchtower
POSTGRES_PASSWORD=watchtower
POSTGRES_DB=watchtower
# The schema owner. Only `pnpm db:migrate` (and the compose `migrate` service) connects with it:
# it runs DDL and creates the restricted login role below. Falls back to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=postgres://watchtower:watchtower@localhost:5432/watchtower
# The restricted login role the api and worker run as (a member of the group role watchtower_app):
# no DDL, and no UPDATE/DELETE/TRUNCATE on the append-only audit log. `pnpm db:migrate` creates
# it from APP_DB_USER and APP_DB_PASSWORD, so run that once before `pnpm dev`.
APP_DB_USER=watchtower_api
APP_DB_PASSWORD=watchtower_api
DATABASE_URL=postgres://watchtower_api:watchtower_api@localhost:5432/watchtower
REDIS_URL=redis://localhost:6379

# --- object storage (MinIO locally, GCS on GCP). The access/secret key pair is also the MinIO root user ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=watchtower
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# --- application secrets ---
# Signs sessions. At least 32 random bytes anywhere but a local machine, for example:
# openssl rand -base64 48
JWT_SECRET=change-me
# Root of the keys that encrypt integration secrets in the database (ADR-004) and the links
# waiting in the email outbox (ADR-006), and key the audit-log address tags. Anywhere but a local
# machine it needs 32 random bytes as base64, for example: openssl rand -base64 32
# Changing it makes links already queued unreadable (they are dropped; people ask again).
APP_ENCRYPTION_KEY=change-me-32-bytes-base64
# Integration credentials saved from the admin page are encrypted under keys derived from
# APP_ENCRYPTION_KEY (ADR-012). To replace the key: put the new one in APP_ENCRYPTION_KEY with
# APP_ENCRYPTION_KEY_VERSION raised by one, move the old one to APP_ENCRYPTION_KEY_PREVIOUS with
# its version, restart, run `credentials rotate` (apps/api CLI), check `credentials status`, then
# remove the two PREVIOUS variables. Set PORTAL_TOKEN_SECRET first (below), or tracking links break.
APP_ENCRYPTION_KEY_VERSION=1
APP_ENCRYPTION_KEY_PREVIOUS=
APP_ENCRYPTION_KEY_PREVIOUS_VERSION=

# --- email (Mailpit in compose catches everything; nothing leaves the machine) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Watchtower <no-reply@example.com>
# Inside docker compose the worker reaches Mailpit as mailpit:1025 whatever SMTP_HOST / SMTP_PORT say
# (those are for `pnpm dev` on this machine; SMTP_PORT also picks the published Mailpit port). To
# send through a real relay from compose set the two below instead, with NODE_ENV=production.
# SMTP_RELAY_HOST=smtp.example.com
# SMTP_RELAY_PORT=587
# Optional SMTP account, both or neither, for the worker. Port 465 = implicit TLS, 587 = STARTTLS.
# With NODE_ENV=production the worker refuses a plain connection and an unauthenticated send unless
# SMTP_ALLOW_INSECURE=true (a trusted internal relay only). The password is a secret: environment only.
SMTP_USER=
SMTP_PASSWORD=
SMTP_ALLOW_INSECURE=false

# --- sign-in and sessions ---
# Break-glass local admin (role head) for when Google sign-in is down. Leave both empty to create
# none from the environment; `pnpm --filter @watchtower/api break-glass <email>` can create one
# later. There is no default password. Set both together, 12 characters or more, and keep the
# password out of version control.
BREAK_GLASS_EMAIL=
BREAK_GLASS_PASSWORD=
# Access JWT lifetime, refresh token idle lifetime, absolute session lifetime, magic link lifetime.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
SESSION_MAX_AGE_SECONDS=2592000
MAGIC_LINK_TTL_SECONDS=900
# Reverse proxies in front of the api whose X-Forwarded-For to trust for the client IP (audit log,
# per-IP rate limits, the break-glass lockout). 0 = trust none (the socket address is used). Set it
# to the number of proxies ONLY when nothing but those proxies can reach the api, otherwise anyone
# can forge the header. With the compose stack:
#   - default (api published on 127.0.0.1:4000): leave 0;
#   - behind Caddy: docker compose -f docker-compose.yml -f docker-compose.proxy.yml up -d --wait
#     (sets 1 and does not publish :4000; open http://localhost:8080, or PROXY_PUBLIC_URL).
# If it is 0 and requests arrive with X-Forwarded-For from a private address, the api logs a warning.
TRUST_PROXY_HOPS=0
# Only for docker-compose.proxy.yml: the address the browser uses for Caddy.
# PROXY_PUBLIC_URL=http://localhost:8080
# Realtime WebSocket (/v1/realtime): how often, in seconds, each open socket's session is checked
# against the database again (a forced logout closes the socket within this time).
REALTIME_REVALIDATE_SECONDS=10
# Serve the OpenAPI page at /docs. Empty = on outside production. Always off when NODE_ENV=production (T-125 QA-33), whatever this says.
DOCS_ENABLED=
# Jobs the worker runs in parallel per queue (1-100).
WORKER_CONCURRENCY=5
# How often the worker's outbox relay hands pending jobs (emails, later channel sends) to the queue,
# in milliseconds (ADR-006). Jobs wait in Postgres while Redis is down and are delivered afterwards.
OUTBOX_POLL_INTERVAL_MS=1000
# How long the worker waits for the AI classifier when it ingests a message before it falls back to
# header rules, in milliseconds (ADR-009; no classifier is wired until T-106, so rules decide today).
INGEST_CLASSIFIER_TIMEOUT_MS=3000
# Daily cleanup in the worker (T-117): days an expired or revoked session, refresh token, magic link
# or tracking link is kept before it is deleted, and days a break-glass lockout counter is kept after
# its last failed sign-in (a counter that still locks is never deleted).
CLEANUP_AUTH_RETENTION_DAYS=7
CLEANUP_BREAK_GLASS_RETENTION_DAYS=30
# Knowledge base chunking in the worker (T-107b), in characters: aim for chunks of about TARGET, never
# longer than MAX, join a tail shorter than MIN to its neighbour, repeat OVERLAP characters when a long
# paragraph is split. Changing them applies to articles published (or re-embedded) from then on.
KB_CHUNK_TARGET_CHARS=900
KB_CHUNK_MAX_CHARS=1400
KB_CHUNK_MIN_CHARS=120
KB_CHUNK_OVERLAP_CHARS=120
# Knowledge base search in the api (T-107c): the cosine similarity (0 to 1) a passage needs to count as a
# vector match. The right value depends on the embedding model; tune it with real queries.
KB_MIN_VECTOR_SIMILARITY=0.25
# "Test connection" on the admin integrations page (ADR-012). false: it always uses offline fakes and
# nothing leaves the machine. true: it runs the adapter's real check against the real service, with
# real credentials. Turning it on is the owner's decision.
CREDENTIAL_LIVE_TEST_ENABLED=false
# --- client portal (T-007, ADR-007) ---
# Signs the tracking links emailed to customers and the proof-of-work challenges. Leave empty to
# derive the key from APP_ENCRYPTION_KEY (separate HKDF label per purpose). To set your own use at
# least 32 random characters, for example: openssl rand -base64 32. Changing it invalidates every
# link already sent (customers ask for a new one by email).
PORTAL_TOKEN_SECRET=
# How long a tracking link works; each email that carries a new link starts the period again. All
# links of a ticket stop working when it is closed.
PORTAL_TOKEN_TTL_DAYS=30
# Human verification of the public form is self-hosted proof-of-work: leading zero bits the browser
# must find (18 is about 1-3 seconds), how long a challenge lives, and the minimum seconds between
# the challenge being issued and the form being sent. Tests use 8 bits and 0 seconds.
PORTAL_POW_DIFFICULTY_BITS=18
PORTAL_POW_TTL_SECONDS=1800
PORTAL_MIN_FILL_SECONDS=3
# Portal file uploads are buffered in memory before they are checked: how many are read at once in
# one api process and per client address (more: 503 with Retry-After), and how many seconds a sender
# may stay silent before it is cut off. Raise the first together with the api container's mem_limit.
PORTAL_UPLOAD_MAX_CONCURRENT=3
PORTAL_UPLOAD_MAX_PER_ADDRESS=1
PORTAL_UPLOAD_IDLE_SECONDS=30
# The slowest a portal upload may be (kilobytes per second, measured over each PORTAL_UPLOAD_IDLE_SECONDS;
# slower = cut off and the slot freed; 0 = off). And whether the proof of work of a submit with files
# must also be sent in the x-portal-proof header (required = checked before a slot is taken; keep
# optional until the web form sends it).
PORTAL_UPLOAD_MIN_KB_PER_SECOND=32
PORTAL_UPLOAD_PROOF_HEADER=optional
# Most megabytes of files customers may upload through the portal in any 24 hours: the whole instance
# is only the backstop (429 upload_quota past it; 0 = no cap). Each client address, email address and
# organization has its own, so one outsider cannot use up everyone's (T-155a C-1).
PORTAL_UPLOAD_DAILY_MB=2048
# Mail reader "Display images" (T-175): the api fetches a remote picture for the reader through an
# SSRF-guarded proxy. https only unless this is true (then plain http pictures load too; nothing else is relaxed).
REMOTE_IMAGES_ALLOW_HTTP=false
PORTAL_UPLOAD_IP_DAILY_MB=100
PORTAL_UPLOAD_EMAIL_DAILY_MB=50
PORTAL_UPLOAD_ORG_DAILY_MB=512
# Malware scan of uploaded files (ADR-022). off = files are served as before and an admin sees a notice.
# clamav = the worker scans every file through clamd and only clean files are shown or sent; needs
# `docker compose --profile scan up -d` (container `clamav`, ~1.5 GB RAM, downloads signatures from
# database.clamav.net). Switching it on scans the files stored earlier too, once.
UPLOAD_SCAN=off
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Archives with a member or a total bigger than clamd scans are refused at upload (ClamAV would answer
# OK for the unscanned rest). Keep equal to MaxFileSize / MaxScanSize / MaxFiles in config/clamav/clamd.conf.
CLAMAV_MAX_FILE_SIZE=25M
CLAMAV_MAX_SCAN_SIZE=100M
CLAMAV_MAX_FILES=10000
# Days after a ticket is closed before its customer files are deleted from storage (0 = keep for ever).
UPLOAD_RETENTION_DAYS=0
# Submissions per hour per client IP, per email address and per organization (429 with Retry-After).
# Prefix of rate-limit counters in Redis; change it only when several instances share one Redis.
RATE_LIMIT_NAMESPACE=wt
PORTAL_RATE_IP_PER_HOUR=20
PORTAL_RATE_EMAIL_PER_HOUR=5
PORTAL_RATE_ORG_PER_HOUR=60

# Prefix of the human ticket number: OPS gives OPS-1234. 2-10 letters/digits, starting with a letter.
# Changing it later renames future displays only (keys already sent in emails keep the old prefix).
TICKET_KEY_PREFIX=OPS

# --- observability ---
# Empty keeps the OTLP trace exporter off. /metrics (Prometheus) is always served by the api.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- integrations: empty = mock mode, nothing is sent outside this machine ---
# Dev login (POST /v1/auth/dev-login) signs anyone in as any role, so it needs an explicit opt-in.
# It works only when this is true AND the Google credentials below are empty (mock mode) AND
# NODE_ENV is not production, and only for accounts it created itself. The api refuses to boot if
# it is true with Google credentials set or in production. docker-compose defaults it to false.
DEV_LOGIN_ENABLED=true
# Staff sign-in. Empty = mock mode (see above); the api refuses to boot in production without both
# values.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
# Required once the OIDC credentials above are set: only this Google Workspace domain may sign in.
GOOGLE_ALLOWED_DOMAIN=example.com
# Test instances on this machine only: exact email addresses (comma separated, no wildcards, ASCII,
# only @gmail.com or @googlemail.com) that may also sign in with a personal Google account that has
# no Workspace domain. The account must still be created by a head; nothing is auto-provisioned.
# Personal accounts have no enforced 2-step verification and cannot be disabled by the organization.
# WARNING: the api refuses to boot with this set when NODE_ENV=production OR when APP_URL is not a
# loopback address (localhost, 127.0.0.1, [::1]), and when an entry is on GOOGLE_ALLOWED_DOMAIN.
# Empty = off.
GOOGLE_ALLOWED_EMAILS=

# --- Gmail (T-102). Without a complete credential the transport is mock (only with GMAIL_MOCK_ENABLED) ---
# Way 1, the default: OAuth of the one support mailbox (T-102e). Create a "Web application" OAuth client in
# the Google Cloud console and register this redirect URI on it (API_URL + path):
#   <API_URL>/v1/admin/integrations/gmail/oauth/callback
# Then a head presses Connect on Admin / Integrations; the refresh token is stored encrypted, never shown.
# Only the client ID and secret are needed here, and they can be saved on the admin page instead.
# GMAIL_OAUTH_REFRESH_TOKEN / GMAIL_OAUTH_MAILBOX are for a deployment that obtained a grant elsewhere:
# when set they win over the stored ones and the Connect button refuses (409 credential_env_locked).
# Scopes asked: gmail.readonly + gmail.send, exactly; a grant with any other scope is refused.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_OAUTH_MAILBOX=
# Way 2, an option: service account with domain-wide delegation. When both ways are complete, the one with
# an environment variable wins over one that is only saved in the database; if neither or both use the
# environment, OAuth is used.
# The path of the key file on THIS machine. docker compose mounts it read-only into the api and
# worker containers and points them at the mount; empty mounts nothing.
GMAIL_SERVICE_ACCOUNT_JSON_PATH=
GMAIL_IMPERSONATE_USER=
# Pub/Sub push (new mail notifications): project and topic that users.watch registers.
PUBSUB_PROJECT_ID=
PUBSUB_TOPIC=
# Reserved, nothing reads these two yet: the receiver is a push endpoint, so there is no pull
# subscription, and no Pub/Sub emulator is wired. They are validated and passed through only.
PUBSUB_EMULATOR_HOST=
PUBSUB_SUBSCRIPTION=
# How the push receiver recognises Pub/Sub: the audience the OIDC token must carry and the service
# account that signs it. The audience is any fixed string set on the subscription (it need not be the
# URL); keep it fixed so a changing tunnel URL needs no api restart (ADR-020). It must differ from
# ALERT_PUSH_AUDIENCE (boot is refused if they are equal: a token for one endpoint must not open the other).
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=
# gmail-tunnel container (dev/POC, ADR-020, compose profile `gmail-tunnel`): a quick tunnel whose URL
# it subscribes on every start. The key file of a service account that may update only that
# subscription (a path on THIS machine, outside the repo, mounted read-only) and the subscription id.
GMAIL_TUNNEL_SA_KEY_PATH=
GMAIL_TUNNEL_SUBSCRIPTION=gmail-push-sub
# Local work only: use the in-memory Gmail when no credential is set (replies are NOT sent, tickets from
# the fake channel can be answered). Refused at boot in production or when APP_URL is not localhost.
# Leave false on anything others can reach: without a credential a reply then fails as channel_not_connected.
GMAIL_MOCK_ENABLED=false
# Push receiver (api): requests per minute per IP accepted before the token is even checked.
GMAIL_PUSH_RATE_PER_MINUTE=600
# Heartbeat (worker, R-2.8): business minutes without a push before the mailbox is marked unhealthy.
GMAIL_HEARTBEAT_STALE_MINUTES=120
# Bounded full sync (worker, R-2.1: no cursor yet, or history.list answered 404): how far back, how many.
GMAIL_FULL_SYNC_DAYS=7
GMAIL_FULL_SYNC_MAX_MESSAGES=500

# --- LINE (T-103). Messaging API channel, then the separate LINE Login channel for customer sign-in ---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# The fake LINE Login (links a signed-in client to a made-up LINE account) is for local work only and
# an explicit opt-in. The api refuses to boot with it true in production, with the LINE Login
# credentials above set, or unless APP_URL is a loopback address. docker-compose defaults it to false. Empty = off.
LINE_LOGIN_FAKE_ENABLED=

# --- Discord (T-104). Webhook for notifications; the application id and public key are for the
# interactions endpoint (verifies the Ed25519 signature of each request) ---
# Reserved until the Discord notifier is merged: the integration catalog and config validate these
# and compose passes them in, but no code on main sends to Discord yet. DISCORD_BOT_TOKEN and
# DISCORD_ALERT_CHANNEL_ID are older names kept for the catalog; the notifier uses the webhook URL.
DISCORD_BOT_TOKEN=
DISCORD_ALERT_CHANNEL_ID=
# Webhook notifications (T-104). Empty = MOCK: notifications are recorded in memory and in the
# database as `mock`, never sent. Only https://discord.com/api/webhooks/<id>/<token> is accepted.
# Each URL is a secret. Which events go to which slot: DISCORD_CHANNEL_MAP (worker, JSON, optional;
# empty = every new ticket to the default slot), for example
# {"routes":[{"name":"all","slot":"default"},{"name":"urgent","slot":"urgent","minPriority":"P2"}]}
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_URGENT=
DISCORD_CHANNEL_MAP=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# --- Outbound replies (T-122d) ---
# Seconds a customer reply waits after the agent presses send, so it can still be cancelled (0-30).
# Validated and passed to the containers; no code on main reads the value yet (the outbound delay is not wired).
OUTBOUND_UNDO_SECONDS=5

# --- repository and cloud read-only tools (T-108) ---
# Reserved until T-108: validated and passed to the containers, but no tool reads them yet.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- AI (T-106, T-132) ---
# One of: mock, anthropic, vertex, claude-cli. The worker picks the adapter from this value; there is no admin
# screen for it yet. mock answers deterministically and sends nothing out (the default).
# A selected provider that is not fully set up never falls back to mock: every AI call fails, is
# recorded in ai_run with an error, the ticket's AI brief says so, and ingestion uses rules.
# What a provider needs:
#   anthropic: ANTHROPIC_API_KEY (here, or in the credential store; this variable wins)
#   vertex:    VERTEX_PROJECT_ID and VERTEX_LOCATION (here or in the credential store) and an access
#              token source. The worker has no token source yet, so vertex fails until one is added.
#   claude-cli: DEV/POC ONLY (ADR-017). Uses the owner's local Claude Code CLI (their subscription)
#              through a bridge that runs on the host: `pnpm claude-bridge` (README, "Local AI via
#              Claude Code CLI"). Needs CLAUDE_CLI_BRIDGE_TOKEN here and in the bridge's shell.
#              Refused at boot when NODE_ENV=production or APP_URL is not a loopback address,
#              unless CLAUDE_CLI_ALLOW_REMOTE=true (ADR-021).
#              Models: aliases the CLI accepts (opus / sonnet / haiku); prices may be 0 (subscription).
#   the rest:  a model id for each tier and a price for each of those models (below).
# AI_PROVIDER never changes an intent's autonomy stage: every intent stays at stage 2 or lower.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# claude-cli only. A random string of 16+ characters (for example `openssl rand -hex 24`); the
# bridge refuses to start without it. The URL default is for the worker in Docker Desktop.
CLAUDE_CLI_BRIDGE_TOKEN=
CLAUDE_CLI_BRIDGE_URL=http://claude-bridge:4317
# ADR-021: claude-cli is refused at boot when NODE_ENV=production or APP_URL is not loopback. An
# instance owner who accepts the Anthropic terms and PDPA duties for their own data sets this to true;
# api and worker then log one warning at boot. Leave false in a fork you have not decided about.
CLAUDE_CLI_ALLOW_REMOTE=false
# The default URL above is the bridge as a compose service (ADR-019); it is not published on any host
# port. A bridge run on the host instead (`pnpm claude-bridge`) needs http://host.docker.internal:4317.
# In your env file (outside the repo) set:
#   AI_PROVIDER=claude-cli
#   AI_MODEL_DEEP=sonnet / AI_MODEL_STANDARD=sonnet / AI_MODEL_LIGHT=sonnet   (CLI aliases; subscription)
#   AI_MODEL_PRICES={"sonnet":{"inputUsdPerMTok":0,"outputUsdPerMTok":0}}
# and start it with `docker compose --profile ai up -d --build claude-bridge`. The lines above stay
# empty/mock here so a fresh clone sends nothing out.
# Login of the bridge container: the long-lived token printed by `claude setup-token` (needs a Claude
# subscription). Only the claude-bridge service gets it; the app never sees it. [VERIFY] the variable
# name against the current Claude Code docs.
CLAUDE_CODE_OAUTH_TOKEN=
# Pinned Claude Code version installed in the bridge image (build argument).
CLAUDE_CODE_VERSION=2.1.316
# Knowledge base folder outside the repo (Markdown + front-matter, see `pnpm kb:sync`). Mounted read-only
# into claude-bridge at /kb. Example: D:/Works/watchtower-kb
WATCHTOWER_KB_DIR=
# Bridge process only (read by `pnpm claude-bridge`, not by the app): CLAUDE_CLI_BRIDGE_PORT (4317),
# CLAUDE_CLI_BRIDGE_HOST (127.0.0.1), CLAUDE_CLI_BRIDGE_TIMEOUT_MS (180000),
# CLAUDE_CLI_BRIDGE_MAX_CONCURRENCY (4), CLAUDE_CLI_BIN (path of claude; found on PATH if empty).
# Most model calls the api (assistant, AI summaries) runs at once against a live provider; the rest of
# the bridge's slots stay for the worker (ADR-023 "Live provider"). Keep it below the bridge's value.
AI_API_MAX_CONCURRENCY=2
# Same for the worker's AI jobs (ADR-029 section 4): api 2 + worker 2 = the bridge's 4 slots.
WORKER_AI_MAX_CONCURRENCY=2
# Both limiters, and the assistant's one-turn-per-person rule, are per process (ADR-029 C-19): stage 1 runs ONE api
# and ONE worker. Setting these above 1 only makes the boot log warn; it does not scale anything.
API_REPLICAS=1
WORKER_REPLICAS=1
VERTEX_PROJECT_ID=
VERTEX_LOCATION=asia-southeast1
# Model id per tier (deep / standard / light), exactly as the provider names it. No model name is
# in the code. Empty = that tier cannot call a real provider. Ignored for mock.
AI_MODEL_DEEP=
AI_MODEL_STANDARD=
AI_MODEL_LIGHT=
# Price per million tokens of each model above, as one JSON object keyed by model id, for example
# {"<model id>":{"inputUsdPerMTok":1,"outputUsdPerMTok":5}}. Required for a real provider: without a
# price the daily cost cap cannot count the call, so the call is refused.
AI_MODEL_PRICES=
# Names with no cue and not in the dictionary (T-153 prototype). off (default, also when empty) = only
# the dictionary and the cues. local = also an in-process English name finder (no network, no model
# download). It does not find Thai names. Measure it: node evals/runner/dist/cli.js redaction --ner local
REDACTION_NER=
# Model per agent (T-301c), optional. A tier name (deep / standard / light) or a model alias of the
# selected provider; empty = the agent's default tier. The grader should run on a different model than
# the drafter (ADR-025 condition 7). An alias needs a price in AI_MODEL_PRICES. Agents: CLASSIFIER,
# INVESTIGATOR, DRAFTER, SUMMARIZER, GRADER, KB_AUTHOR, ROSTER_PLANNER, PERSONAL_ASSISTANT.
# Example (claude-cli): AI_MODEL_DEEP=sonnet ... AI_AGENT_MODEL_GRADER=opus (price both aliases).
AI_AGENT_MODEL_CLASSIFIER=
AI_AGENT_MODEL_INVESTIGATOR=
AI_AGENT_MODEL_DRAFTER=
AI_AGENT_MODEL_SUMMARIZER=
AI_AGENT_MODEL_GRADER=
AI_AGENT_MODEL_KB_AUTHOR=
AI_AGENT_MODEL_ROSTER_PLANNER=
AI_AGENT_MODEL_PERSONAL_ASSISTANT=
# Stage 3 auto-send (ADR-025). ON only when this is exactly the word true (not TRUE, not 1); anything else,
# also empty, is OFF. Read once at start by the api and the worker. With it off nothing is sent without a
# person, and a stage 3 intent acts as stage 2 (draft for approval). [ASK-HUMAN] before setting it on the
# POC or on any instance with real customers; a promotion per intent is still needed.
AI_AUTOSEND_ENABLED=
# Daily caps on what the app itself spends on AI. Empty = use the default for the environment in
# config/budgets.yaml; a value here overrides it. An alert fires at AI_BUDGET_ALERT_PERCENT of a cap
# and the AI stops at the cap (PRD section 6.4, kill switch and budget caps).
AI_DAILY_COST_CAP_USD=
AI_DAILY_TOKEN_CAP=
AI_BUDGET_ALERT_PERCENT=80
# CEO view (T-305b), automation savings = AI-assisted resolved tickets x minutes / 60 (hours), x hourly
# cost (USD) when set. Both are assumptions, printed on the page. Empty minutes = 10; empty hourly
# cost = hours only.
CEO_MINUTES_SAVED_PER_AI_TICKET=
CEO_STAFF_COST_USD_PER_HOUR=
# Weekly brief of the CEO view (T-305c): the worker drafts it with the AI once a week from the real figures and the
# week's incidents, intents and investigation findings (every claim links to its evidence); a head edits and
# publishes it on /dashboard/ceo/brief. The draft is made at the weekday and time below, read in the zone; a
# worker that was down at the time makes it when it is back. With the AI off, over budget or offline for a day the
# draft holds the figures only. WEEKLY_BRIEF_RECIPIENTS (worker: none; api): comma-separated emails the publish
# dialog starts with. Empty = day mon, time 08:00, zone Asia/Bangkok, language en, enabled, no recipients.
WEEKLY_BRIEF_ENABLED=
WEEKLY_BRIEF_DAY=
WEEKLY_BRIEF_TIME=
WEEKLY_BRIEF_TIMEZONE=
WEEKLY_BRIEF_LOCALE=
WEEKLY_BRIEF_RECIPIENTS=
# WEEKLY_BRIEF_RECIPIENT_DOMAINS (api): comma-separated mail domains the publish dialog may also send to, besides active
# staff and the addresses above (T-306a C-13). Empty = active staff only.
WEEKLY_BRIEF_RECIPIENT_DOMAINS=
# The AI assistant (T-134, ADR-017) acts with the signed-in person's own permissions. Per person:
# messages an hour, tokens a day (counted from the assistant's own rows), and how many days a
# conversation is kept (it holds redacted text only). Empty = the defaults in config/budgets.yaml.
ASSISTANT_MESSAGES_PER_HOUR=
ASSISTANT_USER_DAILY_TOKENS=
ASSISTANT_RETENTION_DAYS=
# Embedded AI insights on screen elements (T-414, ADR-029 section 9.4): the narration budget. Empty = the defaults in
# config/budgets.yaml (`insights`). Narration stops at the caps and at STOP_AT_DAILY_PERCENT of the AI daily cap;
# the facts on screen keep working.
INSIGHT_CALLS_PER_HOUR=
INSIGHT_CALLS_PER_DAY=
INSIGHT_DAILY_TOKENS=
INSIGHT_STOP_AT_DAILY_PERCENT=
INSIGHT_MAX_BATCH_ELEMENTS=
INSIGHT_MIN_INTERVAL_MINUTES=
INSIGHT_DEBOUNCE_MINUTES=
INSIGHT_MAX_WAIT_MINUTES=
INSIGHT_VIEWED_WITHIN_HOURS=
INSIGHT_NARRATION_TTL_HOURS=
INSIGHT_BUILDERS_PER_TICK=
INSIGHT_USER_SCOPED_CALLS_PER_DAY=
INSIGHT_USER_SCOPED_PER_USER_PER_DAY=
INSIGHT_USER_SCOPED_MIN_INTERVAL_MINUTES=
# The AI tools' read-only database login (T-108a): a member of watchtower_ai_ro, which can read the
# ai_v_* views and nothing else. Empty = the logs / data / repo tools are off (see below).
# `pnpm db:migrate` creates the login when AI_DB_USER and AI_DB_PASSWORD are both set
# (or run the `provision-ai-role` command). An empty AI_READONLY_DATABASE_URL turns the
# logs / data / repo tools off: the code alone is not accepted as the read-only guarantee.
AI_DB_USER=
AI_DB_PASSWORD=
AI_READONLY_DATABASE_URL=
# Explicit opt-in, like GMAIL_MOCK_ENABLED: let those tools run with no read-only login (a local mock
# run). With false and no AI_READONLY_DATABASE_URL they are off, whatever NODE_ENV is.
AI_TOOLS_WITHOUT_READONLY_LOGIN=false
# Directory with fixtures.json for the GCP Logs / metrics / repo clients while those systems are not
# connected (mock mode, T-203), for example examples/tools in a checkout. Read by the worker (the AI's
# tools) and the api (the buttons a person presses). Empty = those clients are not connected: the
# tools are not registered and the routes answer "not connected".
AI_TOOL_FIXTURES_DIR=

# --- knowledge base (T-107) ---
# One of: mock, local, vertex. mock gives deterministic offline embeddings (not meaningful: use it
# for tests). local is the Ollama `embedder` compose service (profile ai, ADR-030): real semantic
# search in Thai and English, on this machine, free. vertex is not wired yet: the api and the worker
# refuse to start with it. Switching to local: docs/runbooks/local-poc.md.
EMBEDDING_PROVIDER=mock
# For local only. The URL must be loopback or a compose service name (the adapter refuses others).
EMBEDDING_LOCAL_URL=http://embedder:11434
# The model `embedder-init` pulls once, and its vector size (bge-m3 makes 1024).
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
# Resource limits of the embedder container.
# EMBEDDER_MEM_LIMIT=4g
# EMBEDDER_CPUS=2
# Comma-separated host names the URL crawler may fetch, for example docs.example.com. Empty = the
# crawler refuses every URL. Private and link-local addresses are always refused.
KB_CRAWL_ALLOWED_HOSTS=

# --- web push (T-105, live). Empty = in-app notifications only. Make a key pair with: pnpm push:vapid --out <path outside the repo>
# then put the two values and the contact here, or enter them in the app (Settings, Integrations). All three must be set. ---
# The worker sends (RFC 8030 + VAPID RFC 8292 + RFC 8291) only to Chrome/Edge, Firefox and Safari push services.
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
# A mailto: or https: contact for the push services, for example mailto:ops@example.com
WEB_PUSH_SUBJECT=

# --- Phase 2: alerts, incidents, status page (T-200). Empty = mock: nothing reaches an outside service ---
# Alert ingest (T-201c). GCP alert notifications arrive by Pub/Sub push at /v1/inbound/alerts/gcp: the
# audience the OIDC token must carry (usually the public URL of that route) and the service account
# that signs it. Both empty: the route answers 503 and accepts nothing. Never the same value as
# GMAIL_PUSH_AUDIENCE.
ALERT_PUSH_AUDIENCE=
ALERT_PUSH_SERVICE_ACCOUNT=
# Signing secrets of the machine receivers, one per purpose (HMAC-SHA256 in the X-Watchtower-Signature
# header over "<t>.<route>." + body; the route is part of what is signed, so a signature made for one
# route is worthless on another). Credentials: environment first, else set under admin integrations
# ("alerting"). Empty: that route answers 401 to everything.
#   ALERT_WEBHOOK_SECRET    /v1/inbound/alerts/webhook   (route "alerts-webhook")
#   ALERT_HEARTBEAT_SECRET  /v1/inbound/heartbeats/:slug (route "heartbeat:<slug>")
#   DEPLOY_WEBHOOK_SECRET   /v1/inbound/deploys          (route "deploys")
ALERT_WEBHOOK_SECRET=
ALERT_HEARTBEAT_SECRET=
DEPLOY_WEBHOOK_SECRET=
# Alert routes: deliveries per minute per IP accepted before the token or the signature is checked.
ALERT_INGEST_RATE_PER_MINUTE=600
# Discord interactions (buttons, /ack, /incident): per minute per IP before the signature is checked, and per
# Discord user after it. Separate from the alert ingest limit so buttons keep working while alerts flood in.
DISCORD_INTERACTIONS_RATE_PER_MINUTE=600
DISCORD_USER_RATE_PER_MINUTE=60
# The public status page (T-204). false = every /status route answers 404. Opening it is the owner's decision.
STATUS_PAGE_PUBLIC=false
# The product database the data tool reads (T-203c): a read-only login that can read columns, not
# personal ones. Empty = no database (the data tool answers "not connected"). Local mock: it runs in a
# Postgres server of its own (service product-mock-db, memory-limited, not the Watchtower database):
# `docker compose --profile product-mock up product-mock-init` with PRODUCT_MOCK_ADMIN_PASSWORD and
# PRODUCT_MOCK_RO_PASSWORD set (creates product_mock and the login product_mock_ro, see examples/metrics/README.md):
#   PRODUCT_DB_URL=postgres://product_mock_ro:<PRODUCT_MOCK_RO_PASSWORD>@localhost:5433/product_mock
# (inside compose the host is `product-mock-db`, port 5432). A database named product_mock is labelled mock data.
PRODUCT_DB_URL=
# Password of the local mock login: required (12+ letters and digits) to run product-mock-init, no default.
# Outside a local run PRODUCT_DB_URL must carry a real password (16+ characters); the mock one is refused.
PRODUCT_MOCK_RO_PASSWORD=
# Superuser password of the mock's own Postgres server (product-mock-db): letters and digits, no default.
PRODUCT_MOCK_ADMIN_PASSWORD=
# Host port of product-mock-db, on 127.0.0.1.
PRODUCT_MOCK_PORT=5433
# Ad-hoc data statements (a lead's own SELECT) are off. Turn on only when PRODUCT_DB_URL is a sandbox or a
# replica of its own (never the Watchtower database's server): a statement can still make that server run
# out of memory (T-207a, ADR-016). Saved templates run either way.
PRODUCT_DB_ADHOC_ENABLED=false
