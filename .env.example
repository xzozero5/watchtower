# Watchtower environment. Copy to .env (never commit .env).
# Every value here is a local example, not a secret. The "change-me" secrets are accepted only on
# a laptop: the api and worker refuse to boot with a placeholder or short JWT_SECRET /
# APP_ENCRYPTION_KEY when NODE_ENV=production, or whenever APP_URL is not localhost / 127.0.0.1 /
# [::1] (a LAN address or a real host name counts as "not local"). Replace them before you expose
# the stack to anyone else.
#
# Hosts below are localhost, for `pnpm dev` and the integration tests on your machine against
# `docker compose up -d postgres redis minio mailpit`. Inside compose the containers use the
# service names (postgres, redis, minio, mailpit) automatically; docker-compose.yml builds those
# URLs itself, so DATABASE_URL, REDIS_URL, S3_ENDPOINT and SMTP_HOST here do not affect containers.

NODE_ENV=development
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- ports published on 127.0.0.1 by docker-compose.yml ---
WEB_PORT=3000
API_PORT=4000
# The worker serves its health check here.
WORKER_PORT=4100
CADDY_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025

# --- postgres (the compose database is created from these) ---
POSTGRES_USER=watchtower
POSTGRES_PASSWORD=watchtower
POSTGRES_DB=watchtower
# The schema owner. Only `pnpm db:migrate` (and the compose `migrate` service) connects with it:
# it runs DDL and creates the restricted login role below. Falls back to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=postgres://watchtower:watchtower@localhost:5432/watchtower
# The restricted login role the api and worker run as (a member of the group role watchtower_app):
# no DDL, and no UPDATE/DELETE/TRUNCATE on the append-only audit log. `pnpm db:migrate` creates
# it from APP_DB_USER and APP_DB_PASSWORD, so run that once before `pnpm dev`.
APP_DB_USER=watchtower_api
APP_DB_PASSWORD=watchtower_api
DATABASE_URL=postgres://watchtower_api:watchtower_api@localhost:5432/watchtower
REDIS_URL=redis://localhost:6379

# --- object storage (MinIO locally, GCS on GCP). The access/secret key pair is also the MinIO root user ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=watchtower
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# --- application secrets ---
# Signs sessions. At least 32 random bytes anywhere but a local machine, for example:
# openssl rand -base64 48
JWT_SECRET=change-me
# Root of the keys that encrypt integration secrets in the database (ADR-004) and the links
# waiting in the email outbox (ADR-006), and key the audit-log address tags. Anywhere but a local
# machine it needs 32 random bytes as base64, for example: openssl rand -base64 32
# Changing it makes links already queued unreadable (they are dropped; people ask again).
APP_ENCRYPTION_KEY=change-me-32-bytes-base64
# Integration credentials saved from the admin page are encrypted under keys derived from
# APP_ENCRYPTION_KEY (ADR-012). To replace the key: put the new one in APP_ENCRYPTION_KEY with
# APP_ENCRYPTION_KEY_VERSION raised by one, move the old one to APP_ENCRYPTION_KEY_PREVIOUS with
# its version, restart, run `credentials rotate` (apps/api CLI), check `credentials status`, then
# remove the two PREVIOUS variables. Set PORTAL_TOKEN_SECRET first (below), or tracking links break.
APP_ENCRYPTION_KEY_VERSION=1
APP_ENCRYPTION_KEY_PREVIOUS=
APP_ENCRYPTION_KEY_PREVIOUS_VERSION=

# --- email (Mailpit in compose catches everything; nothing leaves the machine) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Watchtower <no-reply@example.com>

# --- sign-in and sessions ---
# Break-glass local admin (role head) for when Google sign-in is down. Leave both empty to create
# none from the environment; `pnpm --filter @watchtower/api break-glass <email>` can create one
# later. There is no default password. Set both together, 12 characters or more, and keep the
# password out of version control.
BREAK_GLASS_EMAIL=
BREAK_GLASS_PASSWORD=
# Access JWT lifetime, refresh token idle lifetime, absolute session lifetime, magic link lifetime.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
SESSION_MAX_AGE_SECONDS=2592000
MAGIC_LINK_TTL_SECONDS=900
# Reverse proxies in front of the api whose X-Forwarded-For to trust for the client IP (audit log,
# per-IP rate limits, the break-glass lockout). 0 = trust none (the socket address is used). Set it
# to the number of proxies ONLY when nothing but those proxies can reach the api, otherwise anyone
# can forge the header. With the compose stack:
#   - default (api published on 127.0.0.1:4000): leave 0;
#   - behind Caddy: docker compose -f docker-compose.yml -f docker-compose.proxy.yml up -d --wait
#     (sets 1 and does not publish :4000; open http://localhost:8080, or PROXY_PUBLIC_URL).
# If it is 0 and requests arrive with X-Forwarded-For from a private address, the api logs a warning.
TRUST_PROXY_HOPS=0
# Only for docker-compose.proxy.yml: the address the browser uses for Caddy.
# PROXY_PUBLIC_URL=http://localhost:8080
# Realtime WebSocket (/v1/realtime): how often, in seconds, each open socket's session is checked
# against the database again (a forced logout closes the socket within this time).
REALTIME_REVALIDATE_SECONDS=10
# How often the worker's outbox relay hands pending jobs (emails, later channel sends) to the queue,
# in milliseconds (ADR-006). Jobs wait in Postgres while Redis is down and are delivered afterwards.
OUTBOX_POLL_INTERVAL_MS=1000
# How long the worker waits for the AI classifier when it ingests a message before it falls back to
# header rules, in milliseconds (ADR-009; no classifier is wired until T-106, so rules decide today).
INGEST_CLASSIFIER_TIMEOUT_MS=3000
# Daily cleanup in the worker (T-117): days an expired or revoked session, refresh token, magic link
# or tracking link is kept before it is deleted, and days a break-glass lockout counter is kept after
# its last failed sign-in (a counter that still locks is never deleted).
CLEANUP_AUTH_RETENTION_DAYS=7
CLEANUP_BREAK_GLASS_RETENTION_DAYS=30
# "Test connection" on the admin integrations page (ADR-012). false: it always uses offline fakes and
# nothing leaves the machine. true: it runs the adapter's real check against the real service, with
# real credentials. Turning it on is the owner's decision.
CREDENTIAL_LIVE_TEST_ENABLED=false
# --- client portal (T-007, ADR-007) ---
# Signs the tracking links emailed to customers and the proof-of-work challenges. Leave empty to
# derive the key from APP_ENCRYPTION_KEY (separate HKDF label per purpose). To set your own use at
# least 32 random characters, for example: openssl rand -base64 32. Changing it invalidates every
# link already sent (customers ask for a new one by email).
PORTAL_TOKEN_SECRET=
# How long a tracking link works; each email that carries a new link starts the period again. All
# links of a ticket stop working when it is closed.
PORTAL_TOKEN_TTL_DAYS=30
# Human verification of the public form is self-hosted proof-of-work: leading zero bits the browser
# must find (18 is about 1-3 seconds), how long a challenge lives, and the minimum seconds between
# the challenge being issued and the form being sent. Tests use 8 bits and 0 seconds.
PORTAL_POW_DIFFICULTY_BITS=18
PORTAL_POW_TTL_SECONDS=1800
PORTAL_MIN_FILL_SECONDS=3
# Submissions per hour per client IP, per email address and per organization (429 with Retry-After).
# Prefix of rate-limit counters in Redis; change it only when several instances share one Redis.
RATE_LIMIT_NAMESPACE=wt
PORTAL_RATE_IP_PER_HOUR=20
PORTAL_RATE_EMAIL_PER_HOUR=5
PORTAL_RATE_ORG_PER_HOUR=60

# Prefix of the human ticket number: OPS gives OPS-1234. 2-10 letters/digits, starting with a letter.
# Changing it later renames future displays only (keys already sent in emails keep the old prefix).
TICKET_KEY_PREFIX=OPS

# --- observability ---
# Empty keeps the OTLP trace exporter off. /metrics (Prometheus) is always served by the api.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- integrations: empty = mock mode, nothing is sent outside this machine ---
# Dev login (POST /v1/auth/dev-login) signs anyone in as any role, so it needs an explicit opt-in.
# It works only when this is true AND the Google credentials below are empty (mock mode) AND
# NODE_ENV is not production, and only for accounts it created itself. The api refuses to boot if
# it is true with Google credentials set or in production. docker-compose defaults it to false.
DEV_LOGIN_ENABLED=true
# Staff sign-in. Empty = mock mode (see above); the api refuses to boot in production without both
# values.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
# Required once the OIDC credentials above are set: only this Google Workspace domain may sign in.
GOOGLE_ALLOWED_DOMAIN=example.com

# --- Gmail (T-102). Without the service account file the transport is mock: nothing is fetched or sent ---
GMAIL_SERVICE_ACCOUNT_JSON_PATH=
GMAIL_IMPERSONATE_USER=
# Pub/Sub push (new mail notifications). Local runs use the emulator (a compose profile arrives
# with T-102); leave PUBSUB_EMULATOR_HOST empty to stay in mock mode with no Pub/Sub at all.
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=
PUBSUB_TOPIC=
PUBSUB_SUBSCRIPTION=
# How the push receiver recognises Pub/Sub: the audience the OIDC token must carry (usually the
# public URL of the receiver) and the service account that signs it.
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=

# --- LINE (T-103). Messaging API channel, then the separate LINE Login channel for customer sign-in ---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# --- Discord (T-104). Webhook for notifications; the application id and public key are for the
# interactions endpoint (verifies the Ed25519 signature of each request) ---
DISCORD_BOT_TOKEN=
DISCORD_ALERT_CHANNEL_ID=
# Webhook notifications (T-104). Empty = MOCK: notifications are recorded in memory and in the
# database as `mock`, never sent. Only https://discord.com/api/webhooks/<id>/<token> is accepted.
# Each URL is a secret. Which events go to which slot: DISCORD_CHANNEL_MAP (worker, JSON, optional;
# empty = every new ticket to the default slot), for example
# {"routes":[{"name":"all","slot":"default"},{"name":"urgent","slot":"urgent","minPriority":"P2"}]}
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_URGENT=
DISCORD_CHANNEL_MAP=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# --- Outbound replies (T-122d) ---
# Seconds a customer reply waits after the agent presses send, so it can still be cancelled (0-30).
OUTBOUND_UNDO_SECONDS=5

# --- repository and cloud read-only tools (T-108) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- AI (T-106; selectable from the admin UI; these are the defaults) ---
# One of: mock, anthropic, vertex. mock answers deterministically and sends nothing out.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=asia-southeast1
# Daily caps on what the app itself spends on AI. Empty = use the default for the environment in
# config/budgets.yaml; a value here overrides it. An alert fires at AI_BUDGET_ALERT_PERCENT of a cap
# and the AI stops at the cap (PRD section 6.4, kill switch and budget caps).
AI_DAILY_COST_CAP_USD=
AI_DAILY_TOKEN_CAP=
AI_BUDGET_ALERT_PERCENT=80

# --- knowledge base (T-107) ---
# One of: mock, vertex. mock gives deterministic offline embeddings; any other provider needs an ADR.
EMBEDDING_PROVIDER=mock
# Comma-separated host names the URL crawler may fetch, for example docs.example.com. Empty = the
# crawler refuses every URL. Private and link-local addresses are always refused.
KB_CRAWL_ALLOWED_HOSTS=

# --- web push (T-105). Empty = in-app notifications only ---
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
# A mailto: or https: contact for the push services, for example mailto:ops@example.com
WEB_PUSH_SUBJECT=
